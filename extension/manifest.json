{
  "manifest_version": 3,
  "name": "DSH Chrome Bridge",
  "version": "0.1.0",
  "description": "Let a remote DeepSeek Harness agent operate the tab you explicitly choose in your own Chrome.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Chrome Bridge",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
