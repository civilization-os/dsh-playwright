{
  "name": "@civilization/deepseek-harness-playwright",
  "version": "0.9.4",
  "description": "基于本机 Chrome 或 Edge 驱动，支持安全可控的网页交互、DOM 树提取与自动化操作手册。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civilization-os/dsh-playwright.git"
  },
  "homepage": "https://github.com/civilization-os/dsh-playwright#readme",
  "bugs": "https://github.com/civilization-os/dsh-playwright/issues",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "skills",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "web": "node scripts/web.js",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "playwright-core": "1.64.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "esbuild": "^0.28.2",
    "react": "^19.2.8"
  }
}
