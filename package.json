{
  "name": "@civilization/deepseek-harness-playwright",
  "version": "0.7.0",
  "description": "Safe local browser operation for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civilization-os/dsh-playwright.git"
  },
  "homepage": "https://github.com/civilization-os/dsh-playwright#readme",
  "bugs": "https://github.com/civilization-os/dsh-playwright/issues",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./chrome-bridge": "./bin/chrome-bridge.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-chrome-bridge": "./bin/chrome-bridge.js"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "extension",
    "docs",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:extension": "node scripts/build-extension.js",
    "test": "node --test tests/*.test.js",
    "web": "node scripts/web.js",
    "prepack": "pnpm build && pnpm build:extension"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "playwright-core": "1.64.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "esbuild": "^0.28.2",
    "react": "^19.2.8"
  }
}
