{
  "name": "@civilization/deepseek-harness-playwright",
  "version": "0.3.0",
  "description": "Safe local browser operation for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civilization-os/dsh-playwright.git"
  },
  "homepage": "https://github.com/civilization-os/dsh-playwright#readme",
  "bugs": "https://github.com/civilization-os/dsh-playwright/issues",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "lib", "skills", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings"] }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "web": "node scripts/web.js",
    "prepack": "pnpm build"
  },
  "engines": { "node": ">=22.19.0" },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "playwright-core": "1.63.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "esbuild": "^0.28.2",
    "react": "^19.2.8"
  }
}
